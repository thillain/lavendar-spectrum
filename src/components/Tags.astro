---
import ColorScript from "./ColorScript.astro";

import { withBase } from "../consts";

const { tags, all } = Astro.props;
---

{all && <h3 class="tag-title">View posts by tag</h3>}
<div class=`${all && "tags"}`>
	{
		tags &&
			tags.map((tag) => (
				<>
					<a class="tag" href={withBase(`tag/${tag}`)}>
						#{tag}
					</a>
					{` `}
				</>
			))
	}
</div>
